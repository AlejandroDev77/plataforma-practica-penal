APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8100
LOG_LEVEL=INFO

SERVICE_TOKEN=
DATABASE_URL=
OCR_LANGUAGE=spa+eng
OCR_DPI=200
OCR_TESSERACT_PATH=
OCR_TESSDATA_PATH=
DOCUMENT_MAX_BYTES=52428800
DOCUMENT_MAX_PAGES=500
PAGE_OCR_THRESHOLD_CHARACTERS=24
PAGE_MAX_PIXELS=40000000
LLM_PROVIDER=disabled
LLM_MODEL=
# Optional audience override. Unset keeps the current local/disabled provider.
# OpenAI requires a separate authorization for every proposal; no automatic fallback.
# SIMULATION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=120
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_SIZE=16384
OLLAMA_TIMEOUT_SECONDS=300
